// Caso de Teste 6: Erro Semântico (Conflito e Limite de Traços)

Sim "Nancy Landgraab" {
    Idade: Adulto;
    Aspiracao: Riqueza;
    
    // ERRO SEMÂNTICO 1 (Regra 1): Traços incompatíveis no mesmo Sim
